          "cachedResultName": "models/gemini-3.1-flash-lite"
        },
        "text": "Extrae únicamente estos campos del documento.\n\nDevuelve SOLO un JSON válido.\n\n{\n  \"id_documento\": \"\",\n  \"total\": \"\",\n  \"fecha\": \"\"\n}",
        "inputType": "binary",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        416,
        0
      ],
      "id": "c10c7141-2827-475c-a285-1fe0f8a7d4e9",
      "name": "Analyze document",
      "credentials": {
        "googlePalmApi": {
          "id": "OWnDoAa4TyerbqRu",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\n// Obtener el texto que devolvió Gemini\nconst rawText = input?.content?.parts?.[0]?.text;\n\nif (!rawText) {\n  return [\n    {\n      json: {\n        id_documento: null,\n        total: null,\n        fecha: null,\n        error: \"Gemini no devolvió contenido de texto\"\n      }\n    }\n  ];\n}\n\n// Quitar los bloques ```json ... ```\nconst cleanText = rawText\n  .replace(/```json/gi, \"\")\n  .replace(/```/g, \"\")\n  .trim();\n\nlet extracted;\n\ntry {\n  extracted = JSON.parse(cleanText);\n} catch (error) {\n  return [\n    {\n      json: {\n        id_documento: null,\n        total: null,\n        fecha: null,\n        error: \"La respuesta de Gemini no contiene un JSON válido\"\n      }\n    }\n  ];\n}\n\n// Normalizar el ID\nconst idDocumento =\n  extracted.id_documento !== null &&\n  extracted.id_documento !== undefined\n    ? String(extracted.id_documento).trim()\n    : null;\n\n// Normalizar el total:\n// \"60.000,00\" -> 60000.00\n// \"$ 60.000,00\" -> 60000.00\nlet totalNormalizado = null;\n\nif (\n  extracted.total !== null &&\n  extracted.total !== undefined &&\n  extracted.total !== \"\"\n) {\n  const totalTexto = String(extracted.total)\n    .replace(/[^\\d,.-]/g, \"\")\n    .trim();\n\n  let numeroTexto;\n\n  if (totalTexto.includes(\",\") && totalTexto.includes(\".\")) {\n    // Formato argentino: 60.000,00\n    numeroTexto = totalTexto\n      .replace(/\\./g, \"\")\n      .replace(\",\", \".\");\n  } else if (totalTexto.includes(\",\")) {\n    // Formato: 60000,00\n    numeroTexto = totalTexto.replace(\",\", \".\");\n  } else {\n    // Formato: 60000.00 o 60000\n    numeroTexto = totalTexto;\n  }\n\n  const numero = Number(numeroTexto);\n\n  if (Number.isFinite(numero)) {\n    totalNormalizado = numero;\n  }\n}\n\n// Normalizar la fecha:\n// \"22/07/2026\" -> \"2026-07-22\"\n// Si ya viene como YYYY-MM-DD, la conserva\nlet fechaNormalizada = null;\n\nif (\n  extracted.fecha !== null &&\n  extracted.fecha !== undefined &&\n  extracted.fecha !== \"\"\n) {\n  const fechaTexto = String(extracted.fecha).trim();\n\n  if (/^\\d{4}-\\d{2}-\\d{2}$/.test(fechaTexto)) {\n    fechaNormalizada = fechaTexto;\n  } else {\n    const match = fechaTexto.match(\n      /^(\\d{1,2})[\\/.-](\\d{1,2})[\\/.-](\\d{4})$/\n    );\n\n    if (match) {\n      const [, dia, mes, anio] = match;\n\n      fechaNormalizada =\n        `${anio}-${mes.padStart(2, \"0\")}-${dia.padStart(2, \"0\")}`;\n    }\n  }\n}\n\nreturn [\n  {\n    json: {\n      id_documento: idDocumento,\n      total: totalNormalizado,\n      fecha: fechaNormalizada\n    }\n  }\n];"
      },
